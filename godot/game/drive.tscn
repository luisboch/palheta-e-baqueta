[gd_scene format=3]

[ext_resource type="Script" path="res://game/drive.gd" id="1_drive"]
[ext_resource type="Theme" path="res://game/theme.tres" id="2_theme"]

[sub_resource type="ButtonGroup" id="ButtonGroup_drives"]

[node name="Drive" type="PanelContainer"]
offset_right = 560.0
offset_bottom = 600.0
theme = ExtResource("2_theme")
script = ExtResource("1_drive")

[node name="Box" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Header" type="Label" parent="Box"]
layout_mode = 2
theme_override_font_sizes/font_size = 34
text = "Pendrive"

[node name="Hint" type="Label" parent="Box"]
layout_mode = 2
theme_override_colors/font_color = Color(0.36, 0.36, 0.4, 1)
theme_override_font_sizes/font_size = 19
text = "Coloque os MP3 na pasta palheta/ do pendrive. Nada é lido antes de você escolher uma ação."
autowrap_mode = 3

[node name="DriveList" type="VBoxContainer" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 12

[node name="Example" type="Button" parent="Box/DriveList"]
layout_mode = 2
theme_override_font_sizes/font_size = 22
toggle_mode = true
button_group = SubResource("ButtonGroup_drives")
text = "PENDRIVE · pasta palheta/ encontrada"
alignment = 0
text_overrun_behavior = 3

[node name="NoDrive" type="Label" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "Nenhum pendrive encontrado. Conecte e toque em Procurar de novo."
autowrap_mode = 3

[node name="Rescan" type="Button" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 0
theme_override_font_sizes/font_size = 20
text = "Procurar de novo"

[node name="Spacer" type="Control" parent="Box"]
layout_mode = 2
size_flags_vertical = 3

[node name="Process" type="Button" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "Trazer MP3s novos (processa sozinho depois)"

[node name="Import" type="Button" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "Importar músicas prontas"

[node name="Export" type="Button" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "Salvar a biblioteca no pendrive"

[node name="Progress" type="ProgressBar" parent="Box"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 20)
layout_mode = 2
max_value = 1.0
step = 0.001
value = 0.4
show_percentage = false

[node name="Message" type="Label" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "Copiando 2 de 5"
autowrap_mode = 3
